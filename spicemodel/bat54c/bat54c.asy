Version 4
SymbolType BLOCK
RECTANGLE Normal -48 -40 48 40
WINDOW 0 0 -40 Bottom 2
WINDOW 3 0 40 Top 2
WINDOW 39 0 64 Top 2
SYMATTR Value BAT54C
SYMATTR SpiceLine Vrrm=30 Vrsm=30 Ir=2u Irsm=2u Vf=1.0 Ifav=0.1 Rs=0.125 trr=5n Cj=10p Eg=0.69 Xti=2
SYMATTR Prefix X
SYMATTR ModelFile .\bat54c_spice.lib
PIN -48 -16 LEFT 8
PINATTR PinName A1
PINATTR SpiceOrder 1
PIN -48 16 LEFT 8
PINATTR PinName A2
PINATTR SpiceOrder 2
PIN 48 0 RIGHT 8
PINATTR PinName K
PINATTR SpiceOrder 3
